<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>SchoolMessenger</AssemblyName>
    <PublishSingleFile>true</PublishSingleFile>
    <ApplicationIcon>../SchoolMessenger.Shared/Branding/brand_mark.ico</ApplicationIcon>
    <Product>교무톡</Product><Description>학교에서 직접 운영하는 학교 메신저</Description><Company>교무톡 프로젝트</Company>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" /><PackageReference Include="QRCoder" Version="1.6.0" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../config/update-publisher.json" LogicalName="SchoolMessenger.UpdatePublisher.json" Condition="Exists('../../config/update-publisher.json')" />
    <EmbeddedResource Include="../../config/update-publisher-server.json" LogicalName="SchoolMessenger.ServerUpdatePublisher.json" Condition="Exists('../../config/update-publisher-server.json')" />
    <Content Include="../../.tools/update-frameworks/winsparkle/WinSparkle-0.9.4/x64/Release/WinSparkle.dll" Link="WinSparkle.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('../../.tools/update-frameworks/winsparkle/WinSparkle-0.9.4/x64/Release/WinSparkle.dll')" />
    <Content Include="../../.tools/update-frameworks/winsparkle/WinSparkle-0.9.4/COPYING*" Link="licenses/WinSparkle/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../scripts/Finish-DesktopUpdate.ps1" Link="Finish-DesktopUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="RequireUpdateFramework" BeforeTargets="Publish">
    <Error Condition="!Exists('../../.tools/update-frameworks/winsparkle/WinSparkle-0.9.4/x64/Release/WinSparkle.dll')" Text="Run scripts/Install-WinSparkle.ps1 before publishing." />
    <Error Condition="!Exists('../../config/update-publisher.json')" Text="An update publisher public key is required before publishing." />
  </Target>
  <ItemGroup>
    <Resource Include="../SchoolMessenger.Shared/Branding/brand_mark.ico" Link="Assets/brand_mark.ico" />
    <Resource Include="../SchoolMessenger.Shared/Branding/admin_mark.ico" Link="Assets/admin_mark.ico" />
    <Compile Include="../SchoolMessenger.Contracts/Timetables.cs" Link="Contracts/Timetables.cs" />
    <Compile Include="../SchoolMessenger.Contracts/SchoolDay.cs" Link="Contracts/SchoolDay.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Office.cs" Link="Contracts/Office.cs" />
    <Compile Include="../SchoolMessenger.Contracts/RosterClassification.cs" Link="Contracts/RosterClassification.cs" />
    <Compile Include="../SchoolMessenger.Contracts/MessageFormatting.cs" Link="Contracts/MessageFormatting.cs" />
    <Compile Include="../SchoolMessenger.Contracts/Feedback.cs" Link="Contracts/Feedback.cs" />
    <Compile Include="../SchoolMessenger.Contracts/RegistrationPolicies.cs" Link="Contracts/RegistrationPolicies.cs" />
    <Compile Include="../SchoolMessenger.Shared/ReleaseNotice.cs" Link="ReleaseNotice.cs" />
    <Compile Include="../SchoolMessenger.Shared/FilePolicy.cs" Link="FilePolicy.cs" />
    <Compile Include="../SchoolMessenger.Shared/AttachmentDownload.cs" Link="AttachmentDownload.cs" />
    <Compile Include="../SchoolMessenger.Shared/FolderAttachment.cs" Link="FolderAttachment.cs" />
    <Compile Include="../SchoolMessenger.Contracts/AttachmentLimits.cs" Link="AttachmentLimits.cs" />
    <Compile Include="../SchoolMessenger.Shared/MessageText.cs" Link="MessageText.cs" />
    <Compile Include="../SchoolMessenger.Shared/SchoolDiscovery.cs" Link="SchoolDiscovery.cs" /><Compile Include="../SchoolMessenger.Shared/SchoolList.cs" Link="SchoolList.cs" /><Compile Include="../SchoolMessenger.Shared/Backend/SchoolAppSettings.cs" Link="SchoolAppSettings.cs" /><EmbeddedResource Include="../SchoolMessenger.Shared/schools.tsv.gz" LogicalName="SchoolMessenger.Schools.tsv.gz" />
    <EmbeddedResource Include="../SchoolMessenger.Shared/updates.json" LogicalName="SchoolMessenger.UpdateNotes.json" />
    <EmbeddedResource Include="../../config/registration-policy.draft.json" LogicalName="SchoolMessenger.RegistrationDraft.json" /><EmbeddedResource Include="../../config/registration-policy.school.json" LogicalName="SchoolMessenger.RegistrationSchool.json" />
  </ItemGroup>
</Project>
