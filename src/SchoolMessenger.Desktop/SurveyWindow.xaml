<Window x:Class="SchoolMessenger.Desktop.SurveyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="교무톡 · 설문" Width="900" Height="720" MinWidth="740" MinHeight="520" Style="{StaticResource SchoolWindow}">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <DockPanel Background="{DynamicResource Soft}"><StackPanel DockPanel.Dock="Top" Margin="14"><TextBlock Text="교직원 설문" FontSize="18" FontWeight="Bold"/><Button Content="새 설문" Click="NewSurvey" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"/></StackPanel>
   <ListBox x:Name="SurveyList" BorderThickness="0" Background="Transparent" SelectionChanged="SelectSurvey"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,8"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
  </DockPanel>
  <DockPanel Grid.Column="1" Margin="18,14">
   <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" Foreground="#AD573C" TextWrapping="Wrap" Margin="0,10,0,0"/>
   <TabControl x:Name="Tabs" BorderThickness="0">
    <TabItem Header="설문 응답"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,18,10,10"><TextBlock x:Name="Heading" Text="설문을 선택하세요" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,12,0,12"/><TextBlock x:Name="DeadlineLabel" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock Text="기명 설문입니다. 작성자는 응답자와 답변을 확인할 수 있습니다." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,16"/><StackPanel x:Name="AnswerPanel"/><Button x:Name="AnswerButton" Content="응답 저장" Click="SaveAnswer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False"/></StackPanel></ScrollViewer></TabItem>
    <TabItem x:Name="ResultsTab" Header="결과" IsEnabled="False"><DockPanel Margin="10,18,10,10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14"><Button Content="결과 새로고침" Click="LoadResults"/><Button Content="CSV 저장" Click="ExportResults" Margin="8,0,0,0"/><Button Content="설문 종료" Click="CloseSurvey" Margin="8,0,0,0"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ResultsPanel"/></ScrollViewer></DockPanel></TabItem>
    <TabItem Header="새 설문"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="10,18,10,10">
     <TextBlock Text="새 설문" FontSize="21" FontWeight="Bold"/><TextBlock Text="설문 제목" Margin="0,18,0,6"/><TextBox x:Name="TitleBox" MaxLength="200"/><TextBlock Text="안내문" Margin="0,14,0,6"/><TextBox x:Name="DescriptionBox" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto"/>
     <TextBlock Text="마감 일시" Margin="0,14,0,6"/><StackPanel Orientation="Horizontal"><DatePicker x:Name="DeadlineDate" Width="150"/><TextBox x:Name="DeadlineTime" Text="17:00" Width="90" Margin="8,0,0,0" MaxLength="5"/></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,14,0,8"><Button Content="대상 선택" Click="ChooseTargets"/><CheckBox x:Name="SendAll" Content="전체 교직원" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel><TextBlock x:Name="TargetLabel" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
     <StackPanel x:Name="QuestionsPanel" Margin="0,14,0,0"/><Button Content="문항 추가" Click="AddQuestionClick" HorizontalAlignment="Left" Margin="0,12,0,0"/><Button x:Name="CreateButton" Content="설문 보내기" Click="CreateClick" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </DockPanel>
 </Grid>
</Window>
