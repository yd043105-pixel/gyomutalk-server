<Window x:Class="SchoolMessenger.Desktop.SurveyWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="교무톡 · 설문" Width="960" Height="740" MinWidth="760" MinHeight="540" FontSize="13" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner">
 <Grid Background="{DynamicResource Surface}">
  <DockPanel x:Name="BrowsePane">
   <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16,24,0"><StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="새 설문" Click="NewSurvey" Style="{StaticResource PrimaryButton}"/><TextBlock Text="설문" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
    <StackPanel Orientation="Horizontal" Margin="-4,4,0,0"><Button x:Name="ReceivedTab" Style="{StaticResource TabButton}" Content="받은 설문" Uid="received" Click="ChangeBox"/><Button x:Name="SentTab" Style="{StaticResource TabButton}" Content="보낸 설문" Uid="sent" Click="ChangeBox"/></StackPanel>
   </StackPanel></Border>
   <TextBlock x:Name="Feedback" DockPanel.Dock="Bottom" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Padding="24,10" Background="{DynamicResource Subtle}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   <Grid>
   <ContentControl x:Name="EmptyHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   <Grid x:Name="BrowseBody"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12">
     <ListBox x:Name="SurveyList" SelectionChanged="SelectSurvey"><ListBox.ItemTemplate><DataTemplate><StackPanel>
      <DockPanel><Border x:Name="NamelessTag" DockPanel.Dock="Right" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Top"><TextBlock Text="익명" FontSize="11" Foreground="{DynamicResource Blue}"/></Border><TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold"/></DockPanel>
      <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
     </StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding Anonymous}" Value="False"><Setter TargetName="NamelessTag" Property="Visibility" Value="Collapsed"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Border>
    <TabControl x:Name="Tabs" Grid.Column="1" BorderThickness="0" Padding="0" Background="Transparent">
     <TabControl.ItemContainerStyle><Style TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed"/></Style></TabControl.ItemContainerStyle>
     <TabItem><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
      <WrapPanel><TextBlock x:Name="Heading" Text="설문을 선택하세요" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Border x:Name="AnswerTag" Background="{DynamicResource Pale}" CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="익명" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blue}"/></Border></WrapPanel>
      <TextBlock x:Name="DeadlineLabel" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0"/>
      <TextBlock x:Name="Description" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <Border x:Name="NoticeCard" Background="{DynamicResource Subtle}" CornerRadius="10" Padding="12,10" Margin="0,12,0,4"><TextBlock x:Name="NoticeText" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
      <StackPanel x:Name="AnswerPanel"/>
      <Button x:Name="AnswerButton" Content="응답 저장" Click="SaveAnswer" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" IsEnabled="False"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="ResultsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="CloseButton" Content="설문 종료" Click="CloseSurvey" Style="{StaticResource DangerButton}" Margin="8,0,8,0"/><Button Content="CSV 저장" Click="ExportResults"/></StackPanel>
       <WrapPanel VerticalAlignment="Center"><TextBlock x:Name="ResultTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/><Border x:Name="ResultTag" Background="{DynamicResource Pale}" CornerRadius="10" Padding="9,2" VerticalAlignment="Center" Visibility="Collapsed"><TextBlock Text="익명" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Blue}"/></Border></WrapPanel>
      </DockPanel>
      <TextBlock x:Name="ResultSummary" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
      <StackPanel x:Name="ResultsPanel"/>
      <TextBlock x:Name="ResultNote" FontSize="12" Foreground="{DynamicResource Faint}" TextWrapping="Wrap" Margin="0,4,0,0" Text="응답자가 적거나 결과를 실시간으로 지켜보면, 답변 내용과 응답 시점만으로 누구인지 짐작될 수 있습니다." Visibility="Collapsed"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
   </Grid>
  </DockPanel>
  <DockPanel x:Name="CreatePane" Visibility="Collapsed">
   <Border DockPanel.Dock="Bottom" Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="취소" Click="CancelCreate" Style="{StaticResource SubtleButton}" Margin="0,0,8,0"/><Button x:Name="CreateButton" Content="게시" Click="CreateClick" Style="{StaticResource PrimaryButton}"/></StackPanel>
    <TextBlock x:Name="CreateFeedback" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
   </DockPanel></Border>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,20">
    <TextBlock Text="새 설문" FontSize="22" FontWeight="Bold"/>
    <TextBlock Text="제목" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,16,0,6"/><TextBox x:Name="TitleBox" MaxLength="200"/>
    <TextBlock Text="안내문" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,6"/><TextBox x:Name="DescriptionBox" MaxLength="5000" AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="마감" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><DockPanel><TextBox x:Name="DeadlineTime" DockPanel.Dock="Right" Text="17:00" Width="72" Margin="8,0,0,0" MaxLength="5"/><DatePicker x:Name="DeadlineDate"/></DockPanel></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="대상" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><DockPanel><CheckBox x:Name="SendAll" DockPanel.Dock="Right" Content="전체 교직원" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/><Button Content="대상 선택" Click="ChooseTargets" HorizontalAlignment="Left"/></DockPanel><TextBlock x:Name="TargetLabel" FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
    </Grid>
    <Border Background="{DynamicResource Pale}" CornerRadius="10" Padding="16,12" Margin="0,12,0,0"><DockPanel>
     <CheckBox x:Name="AnonymousBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="익명 설문"/>
     <StackPanel><TextBlock Text="익명 설문" FontWeight="SemiBold"/><TextBlock FontSize="12" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="응답은 게시자 PC로 옮겨진 뒤 서버에서 지워지고, 누가 어떤 답을 했는지 게시자도 서버 관리자도 알 수 없습니다. 제출한 답은 고칠 수 없고, 게시한 뒤에는 이 설정을 바꿀 수 없습니다. 결과는 게시한 PC에서만 볼 수 있습니다. 응답자가 적으면 답변 내용으로 누구인지 짐작될 수 있습니다."/></StackPanel>
    </DockPanel></Border>
    <TextBlock Text="문항" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
    <StackPanel x:Name="QuestionsPanel"/>
    <Button Content="문항 추가" Click="AddQuestionClick" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
