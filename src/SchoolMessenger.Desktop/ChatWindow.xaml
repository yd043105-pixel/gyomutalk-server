<Window x:Class="SchoolMessenger.Desktop.ChatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="교무톡 · 채팅" Width="940" Height="680" MinWidth="720" MinHeight="500" FontSize="13" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="16,16,16,12"><Button DockPanel.Dock="Right" Content="새 대화방" Click="NewRoom" Style="{StaticResource PrimaryButton}"/><TextBlock Text="채팅" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <ListBox x:Name="Rooms" Background="Transparent" Margin="8,0" SelectionChanged="SelectRoom" PreviewMouseRightButtonDown="KeepSelection" ContextMenuOpening="RoomMenu">
    <ListBox.ContextMenu><ContextMenu><MenuItem x:Name="RenameItem" Header="이름 바꾸기" Click="RenameRoom"/><MenuItem x:Name="MuteItem" Header="이 방 알림 끄기" Click="MuteRoom"/><Separator/><MenuItem x:Name="LeaveItem" Header="대화방 나가기" Foreground="{DynamicResource Danger}" Click="LeaveRoom"/></ContextMenu></ListBox.ContextMenu>
    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Path x:Name="MutedMark" DockPanel.Dock="Right" Data="{StaticResource BellOff}" Stroke="{DynamicResource Faint}" StrokeThickness="1.2" Width="14" Height="14" Margin="4,0,0,0" ToolTip="알림 꺼짐"/><TextBlock x:Name="RoomName" Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
     <Border x:Name="UnreadBadge" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Blue}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,4,0,0" HorizontalAlignment="Right"><TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid><DataTemplate.Triggers>
     <DataTrigger Binding="{Binding Unread}" Value="0"><Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding Muted}" Value="False"><Setter TargetName="MutedMark" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="RoomName" Property="Foreground" Value="{DynamicResource Blue}"/></DataTrigger>
    </DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <ContentControl x:Name="EmptyHost" Grid.Column="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <DockPanel x:Name="ChatPane" Grid.Column="1">
   <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,14"><DockPanel>
    <Button x:Name="BellButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="ToggleMute" Width="32" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center"><Path x:Name="BellIcon" Data="{StaticResource BellOn}" Stroke="{DynamicResource Muted}" StrokeThickness="1.3" Width="16" Height="16"/></Button>
    <StackPanel><TextBlock x:Name="RoomTitle" Text="대화방을 선택하세요" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MembersLabel" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,16">
    <TextBlock x:Name="Feedback" Foreground="#AD573C" TextWrapping="Wrap" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="12,10"><StackPanel>
     <ItemsControl x:Name="FilesList"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource Subtle}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6" Padding="10,0,2,0" Margin="0,0,8,8" MinHeight="28"><StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Description}" ToolTip="{Binding Path}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
       <Button Content="×" Tag="{Binding}" Click="RemoveFile" ToolTip="보내지 않기" AutomationProperties.Name="보내지 않기" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" Width="24" Height="24" Margin="4,0,0,0" Foreground="{DynamicResource Muted}" HorizontalContentAlignment="Center"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Grid>
      <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="44" MaxHeight="120" VerticalContentAlignment="Top" MaxLength="20000" VerticalScrollBarVisibility="Auto" PreviewKeyDown="MessageKey"/>
      <TextBlock Text="메시지를 입력하세요" Foreground="{DynamicResource Faint}" IsHitTestVisible="False" Margin="2,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=BodyBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <DockPanel Margin="0,8,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Click="SendClick" Style="{StaticResource PrimaryButton}"/><StackPanel Orientation="Horizontal"><Button x:Name="AttachButton" Content="파일 첨부" Click="Attach" Style="{StaticResource SubtleButton}"/><TextBlock Text="Enter 전송 · Shift+Enter 줄바꿈" FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></DockPanel>
    </StackPanel></Border>
   </StackPanel>
   <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,12">
    <TextBlock x:Name="LocalNote" Text="이 PC에 저장된 대화만 보입니다. 다른 PC에서 받은 대화는 볼 수 없습니다." FontSize="12" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8" Visibility="Collapsed"/>
    <Button x:Name="OlderButton" Content="이전 대화 불러오기" Click="Older" HorizontalAlignment="Center" Style="{StaticResource SubtleButton}" FontSize="12" Visibility="Collapsed"/>
    <ItemsControl x:Name="MessagesList"><ItemsControl.ItemTemplate><DataTemplate>
     <Border x:Name="Bubble" Background="{DynamicResource Subtle}" CornerRadius="10" Padding="12,10" Margin="0,4,72,4" HorizontalAlignment="Left" MinWidth="120"><StackPanel>
      <TextBlock Text="{Binding Heading}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,4"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,0"><Button Content="{Binding Description}" Tag="{Binding}" Click="Download" IsEnabled="{Binding Available}" HorizontalAlignment="Left" FontSize="12"/><TextBlock Text="{Binding Expiry}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></Border>
    <DataTemplate.Triggers><DataTrigger Binding="{Binding Mine}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="Margin" Value="72,4,0,4"/><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Pale}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
