<Window x:Class="SchoolMessenger.Desktop.ChatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="교무톡 · 채팅" Width="940" Height="680" MinWidth="720" MinHeight="500" FontSize="13" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="16,16,16,12"><Button DockPanel.Dock="Right" Click="NewRoom" Style="{StaticResource PrimaryButton}" Padding="10,5" AutomationProperties.Name="새 대화방"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddIcon}" Style="{StaticResource Glyph}" Width="12" Height="12"/><TextBlock Text="새 대화방" Margin="5,0,0,0"/></StackPanel></Button><TextBlock Text="채팅" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
   <ListBox x:Name="Rooms" Background="Transparent" Margin="8,0" SelectionChanged="SelectRoom" PreviewMouseRightButtonDown="KeepSelection" ContextMenuOpening="RoomMenu">
    <ListBox.ContextMenu><ContextMenu><MenuItem x:Name="RenameItem" Header="이름 바꾸기" Click="RenameRoom"><MenuItem.Icon><Path Data="{StaticResource ChatIcon}" Stroke="{DynamicResource Blue}" StrokeThickness="1.5" Stretch="Uniform" Width="15" Height="15"/></MenuItem.Icon></MenuItem><MenuItem x:Name="MuteItem" Header="이 방 알림 끄기" Click="MuteRoom"><MenuItem.Icon><Path Data="{StaticResource BellOff}" Stroke="{DynamicResource Blue}" StrokeThickness="1.5" Stretch="Uniform" Width="15" Height="15" x:Name="MuteGlyph"/></MenuItem.Icon></MenuItem><Separator/><MenuItem x:Name="LeaveItem" Header="대화방 나가기" Foreground="{DynamicResource Danger}" Click="LeaveRoom"><MenuItem.Icon><Path Data="{StaticResource CloseIcon}" Stroke="{DynamicResource Danger}" StrokeThickness="1.5" Stretch="Uniform" Width="12" Height="12" Margin="1.5"/></MenuItem.Icon></MenuItem></ContextMenu></ListBox.ContextMenu>
    <ListBox.ItemTemplate><DataTemplate><DockPanel>
     <Grid DockPanel.Dock="Left" Width="40" Height="40" Margin="0,0,10,0" VerticalAlignment="Center">
      <Border x:Name="SoloAvatar" Width="38" Height="38" CornerRadius="19" Background="{Binding AvatarBack}"><TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarInk}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border x:Name="BackAvatar" Visibility="Collapsed" Width="27" Height="27" CornerRadius="14" Background="{Binding AvatarBack}" HorizontalAlignment="Left" VerticalAlignment="Top"><TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarInk}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <Border x:Name="FrontAvatar" Visibility="Collapsed" Width="29" Height="29" CornerRadius="15" BorderThickness="2" BorderBrush="{DynamicResource Soft}" Background="{Binding SecondBack}" HorizontalAlignment="Right" VerticalAlignment="Bottom"><TextBlock Text="{Binding SecondInitial}" Foreground="{Binding SecondInk}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     </Grid>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><Path x:Name="MutedMark" DockPanel.Dock="Right" Data="{StaticResource BellOff}" Stroke="{DynamicResource Faint}" StrokeThickness="1.6" Stretch="Uniform" Width="13" Height="13" Margin="4,0,0,0" ToolTip="알림 꺼짐"/><TextBlock x:Name="RoomName" Text="{Binding Display}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel>
     <TextBlock Grid.Column="1" Text="{Binding When}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="8,0,0,0" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="1" Text="{Binding Preview}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
     <Border x:Name="UnreadBadge" Grid.Row="1" Grid.Column="1" Background="{DynamicResource Danger}" CornerRadius="9" MinWidth="18" Height="18" Padding="5,0" Margin="8,4,0,0" HorizontalAlignment="Right"><TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    </Grid></DockPanel><DataTemplate.Triggers>
     <DataTrigger Binding="{Binding Group}" Value="True"><Setter TargetName="SoloAvatar" Property="Visibility" Value="Collapsed"/><Setter TargetName="BackAvatar" Property="Visibility" Value="Visible"/><Setter TargetName="FrontAvatar" Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding Unread}" Value="0"><Setter TargetName="UnreadBadge" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding Muted}" Value="False"><Setter TargetName="MutedMark" Property="Visibility" Value="Collapsed"/></DataTrigger>
     <DataTrigger Binding="{Binding IsSelected,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="RoomName" Property="Foreground" Value="{DynamicResource Blue}"/></DataTrigger>
    </DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
  </DockPanel></Border>
  <ContentControl x:Name="EmptyHost" Grid.Column="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  <DockPanel x:Name="ChatPane" Grid.Column="1">
   <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,14"><DockPanel>
    <Button x:Name="BellButton" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Click="ToggleMute" Width="32" Padding="0" VerticalAlignment="Center" HorizontalContentAlignment="Center"><Path x:Name="BellIcon" Data="{StaticResource BellOn}" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" Stretch="Uniform" Width="17" Height="17"/></Button>
    <StackPanel><TextBlock x:Name="RoomTitle" Text="대화방을 선택하세요" FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="MembersLabel" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
   </DockPanel></Border>
   <StackPanel DockPanel.Dock="Bottom" Margin="24,8,24,16">
    <TextBlock x:Name="Feedback" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12" Padding="14,12" Background="{DynamicResource Surface}"><StackPanel>
     <ItemsControl x:Name="FilesList"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ItemsControl.Style><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
      <Border Background="{DynamicResource Pale}" CornerRadius="14" Padding="12,0,4,0" Margin="0,0,8,8" MinHeight="28"><StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding Description}" ToolTip="{Binding Path}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
       <Button Content="×" Tag="{Binding}" Click="RemoveFile" ToolTip="보내지 않기" AutomationProperties.Name="보내지 않기" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" Width="24" Height="24" Margin="4,0,0,0" Foreground="{DynamicResource Muted}" HorizontalContentAlignment="Center"/>
      </StackPanel></Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <Grid>
      <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="44" MaxHeight="120" VerticalContentAlignment="Top" MaxLength="20000" VerticalScrollBarVisibility="Auto" PreviewKeyDown="MessageKey"/>
      <TextBlock Text="메시지를 입력하세요" Foreground="{DynamicResource Faint}" IsHitTestVisible="False" Margin="2,0,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=BodyBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <DockPanel Margin="0,8,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Click="SendClick" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="보내기"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}" Width="14" Height="14"/><TextBlock Text="보내기" Margin="6,0,0,0"/></StackPanel></Button><StackPanel Orientation="Horizontal"><Button x:Name="AttachButton" Click="Attach" Style="{StaticResource FormatButton}" ToolTip="파일 첨부" AutomationProperties.Name="파일 첨부"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AttachIcon}" Style="{StaticResource Glyph}" Width="16" Height="16"/><TextBlock Text="파일" Margin="5,0,0,0"/></StackPanel></Button><TextBlock Text="Enter 전송 · Shift+Enter 줄바꿈" FontSize="11" Foreground="{DynamicResource Faint}" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel></DockPanel>
    </StackPanel></Border>
   </StackPanel>
   <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"><StackPanel Margin="24,12">
    <TextBlock x:Name="LocalNote" Text="이 PC에 저장된 대화만 보입니다. 다른 PC에서 받은 대화는 볼 수 없습니다." FontSize="12" Foreground="{DynamicResource Faint}" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,8" Visibility="Collapsed"/>
    <Button x:Name="OlderButton" Content="이전 대화 불러오기" Click="Older" HorizontalAlignment="Center" Style="{StaticResource SubtleButton}" FontSize="12" Visibility="Collapsed"/>
    <ItemsControl x:Name="MessagesList"><ItemsControl.ItemTemplate><DataTemplate>
     <DockPanel x:Name="Line" Margin="0,6,72,6" HorizontalAlignment="Left">
      <Border x:Name="Face" DockPanel.Dock="Left" Width="32" Height="32" CornerRadius="16" Background="{Binding AvatarBack}" VerticalAlignment="Top" Margin="0,0,10,0"><TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarInk}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <StackPanel>
       <TextBlock x:Name="Meta" Text="{Binding Heading}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="2,0,0,4"/>
       <Border x:Name="Bubble" Background="{DynamicResource Soft}" CornerRadius="4,14,14,14" Padding="14,10" HorizontalAlignment="Left" MinWidth="60"><StackPanel>
        <TextBlock x:Name="BodyText" Text="{Binding Body}" TextWrapping="Wrap" Foreground="{DynamicResource Ink}"/>
        <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,8,0,0"><Button Tag="{Binding}" Click="Download" IsEnabled="{Binding Available}" HorizontalAlignment="Left" FontSize="12" AutomationProperties.Name="{Binding Description}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AttachIcon}" Style="{StaticResource Glyph}" Width="13" Height="13"/><TextBlock Text="{Binding Description}" Margin="6,0,0,0"/></StackPanel></Button><TextBlock Text="{Binding Expiry}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       </StackPanel></Border>
      </StackPanel>
     </DockPanel>
    <DataTemplate.Triggers><DataTrigger Binding="{Binding Mine}" Value="True"><Setter TargetName="Line" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Line" Property="Margin" Value="72,6,0,6"/><Setter TargetName="Face" Property="Visibility" Value="Collapsed"/><Setter TargetName="Meta" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="CornerRadius" Value="14,4,14,14"/><Setter TargetName="Bubble" Property="Background" Value="{DynamicResource Blue}"/><Setter TargetName="BodyText" Property="Foreground" Value="{DynamicResource OnAccent}"/></DataTrigger></DataTemplate.Triggers>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
