<Window x:Class="SchoolMessenger.Desktop.ChatWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="교무톡 · 채팅" Width="900" Height="680" MinWidth="700" MinHeight="500" Style="{StaticResource SchoolWindow}">
 <Grid Background="{DynamicResource Surface}"><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <DockPanel Background="{DynamicResource Soft}" Margin="0,0,1,0">
   <StackPanel DockPanel.Dock="Top" Margin="14"><TextBlock Text="교직원 채팅" FontSize="18" FontWeight="Bold"/><Button Content="새 대화방" Click="NewRoom" Margin="0,12,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel>
   <ListBox x:Name="Rooms" BorderThickness="0" Background="Transparent" SelectionChanged="SelectRoom" DisplayMemberPath="Label"/>
  </DockPanel>
  <DockPanel Grid.Column="1" Margin="18,14">
   <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="RoomTitle" Text="대화방을 선택하세요" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="MembersLabel" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,10"/><Button x:Name="OlderButton" Content="이전 대화 불러오기" Click="Older" HorizontalAlignment="Left" Padding="10,4" FontSize="11" Visibility="Collapsed"/></StackPanel>
   <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
    <TextBlock x:Name="Feedback" Foreground="#AD573C" TextWrapping="Wrap" Margin="0,0,0,6"/>
    <TextBlock x:Name="FileHint" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" FontSize="11"/>
    <TextBox x:Name="BodyBox" AcceptsReturn="True" TextWrapping="Wrap" Height="80" MaxLength="20000" VerticalScrollBarVisibility="Auto" PreviewKeyDown="MessageKey"/>
    <DockPanel Margin="0,8,0,0"><Button x:Name="SendButton" DockPanel.Dock="Right" Content="보내기" Click="SendClick" Style="{StaticResource PrimaryButton}"/><StackPanel Orientation="Horizontal"><Button x:Name="AttachButton" Content="파일 첨부" Click="Attach"/><Button x:Name="ClearFilesButton" Content="첨부 해제" Click="ClearFiles" Margin="6,0,0,0"/><TextBlock Text="Enter 전송 · Shift+Enter 줄바꿈" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></DockPanel>
   </StackPanel>
   <ScrollViewer x:Name="MessagesScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="MessagesList"><ItemsControl.ItemTemplate><DataTemplate>
    <Border Background="{DynamicResource Soft}" CornerRadius="10" Padding="13" Margin="0,6,0,6"><StackPanel>
     <TextBlock Text="{Binding Heading}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/><TextBlock Text="{Binding Body}" TextWrapping="Wrap"/>
     <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,9,0,0"><Button Content="{Binding Description}" Tag="{Binding}" Click="Download" IsEnabled="{Binding Available}" HorizontalAlignment="Left"/><TextBlock Text="{Binding Expiry}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
  </DockPanel>
 </Grid>
</Window>
