<Window x:Class="SchoolMessenger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="교무톡 · 온라인 교무실" Width="450" Height="820" MinWidth="380" MinHeight="580" Style="{StaticResource SchoolWindow}" Closing="WindowClosing">
 <Grid Background="Transparent">
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="18" Margin="8"><DockPanel x:Name="Workspace" Visibility="Collapsed">
   <Border DockPanel.Dock="Top" Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="17,17,0,0" Padding="14,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentControl x:Name="IdentityDot" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1"><TextBlock x:Name="IdentityLabel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="IdentityDepartment" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="10,0,0,0"><TextBlock x:Name="IdentityStatus" Text="연결 중" Foreground="{DynamicResource Muted}" FontSize="10" HorizontalAlignment="Right"/><Button x:Name="UnreadShortcut" Content="미확인 0" Tag="unread" Click="OpenMailboxClick" BorderThickness="0" Background="{DynamicResource Pale}" Foreground="{DynamicResource Blue}" Padding="8,4" FontSize="10" Margin="0,5,0,0"/></StackPanel>
    </Grid>
   </Border>
   <Border DockPanel.Dock="Bottom" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="10,7"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionLabel" Text="서버 연결 확인 중" Foreground="{DynamicResource Muted}" FontSize="10"/><TextBlock x:Name="RosterHint" Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="10" Margin="8,0,0,0"/></Grid>
    <TextBlock x:Name="StatusLabel" Foreground="#AD573C" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border x:Name="NavigationRail" DockPanel.Dock="Left" Width="78" Background="{DynamicResource Soft}"><DockPanel x:Name="NavigationLayout" Margin="0,6">
    <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" ToolTip="설정" Style="{StaticResource RailButton}" Click="OpenSettings"><StackPanel><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="설정" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel>
     <Button.ContextMenu><ContextMenu><MenuItem Header="화면 색상 · 유리 효과" Click="OpenAppearance"/><Separator/><MenuItem x:Name="Quiet" Header="알림 소리 끄기" IsCheckable="True"/><MenuItem x:Name="DoNotDisturb" Header="방해금지" IsCheckable="True"/><MenuItem x:Name="AutoStartMenu" Header="Windows 로그인 시 자동 실행" IsCheckable="True" Checked="StartupChanged" Unchecked="StartupChanged"/><Separator/><MenuItem Header="업데이트 내역" Click="OpenUpdates"/><MenuItem Header="오류 신고 · 개선 의견" Click="OpenFeedback"/><MenuItem Header="약관·개인정보 안내" Click="OpenPolicies"/><MenuItem Header="개인정보 열람·정정·삭제 요청" Click="OpenPrivacyRequest"/><MenuItem Header="내 비밀번호 변경" Click="ChangePassword"/><MenuItem x:Name="AdminButton" Header="교직원 · 서버 관리" Click="OpenAdmin" Visibility="Collapsed"/><Separator/><MenuItem Header="로그아웃" Click="Logout"/><MenuItem Header="프로그램 종료" Click="ExitApp"/></ContextMenu></Button.ContextMenu>
    </Button>
    <StackPanel x:Name="NavigationItems">
     <Button x:Name="OrganizationButton" Style="{StaticResource RailButton}" Background="{DynamicResource Blue}" Foreground="{DynamicResource OnAccent}" Click="ShowOrganization"><StackPanel><Path Data="{StaticResource TreeIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="조직도" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button x:Name="FavoritesButton" Style="{StaticResource RailButton}" Click="ToggleFavorites"><StackPanel><Path Data="{StaticResource StarIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="즐겨찾기" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Border x:Name="MessageSection" Background="{DynamicResource MessageSectionTint}" CornerRadius="5" Padding="3,3" Margin="6,4,6,3"><TextBlock Text="메시지" Style="{StaticResource RailSection}"/></Border>
     <Button Style="{StaticResource RailButton}" Tag="received" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="받은함" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Tag="sent" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="보낸함" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenChatClick"><StackPanel><Path Data="{StaticResource ChatIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="채팅" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenWorkClick"><StackPanel><Path Data="{StaticResource FileIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="할 일·제출" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenSurveyClick"><StackPanel><Path Data="{StaticResource SurveyIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="설문" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Border x:Name="SchoolSection" Background="{DynamicResource SchoolSectionTint}" CornerRadius="5" Padding="3,3" Margin="6,4,6,3"><TextBlock Text="학교 업무" Style="{StaticResource RailSection}"/></Border>
     <Button Style="{StaticResource RailButton}" Click="OpenAnnouncementClick"><StackPanel><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="가정통신문" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenTimetableClick"><StackPanel><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="시간표" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button x:Name="ElectivesButton" Style="{StaticResource RailButton}" Click="OpenElectivesClick" Visibility="Collapsed"><StackPanel><Path Data="{StaticResource SurveyIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="수강신청" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenOfficeClick"><StackPanel><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="일정·예약" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" Click="OpenCounselingClick"><StackPanel><Path Data="{StaticResource HistoryIcon}" Style="{StaticResource Glyph}"/><TextBlock Text="상담 예약" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <DockPanel>
    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="12,12,12,10"><StackPanel><DockPanel Margin="0,0,0,10"><Button x:Name="SortButton" DockPanel.Dock="Right" Content="이름순 ↕" FontSize="10" Foreground="{DynamicResource Muted}" BorderThickness="0" Padding="4,5" Click="ToggleSort"/><TextBlock x:Name="RosterTitle" Text="교직원" FontSize="15" FontWeight="SemiBold"/></DockPanel>
     <Grid><TextBox x:Name="PeopleSearch" ToolTip="이름 또는 부서명 검색" TextChanged="SearchPeople" Padding="30,8,8,8"/>
      <Path Data="M10,4 A6,6 0 1 1 9.99,4 M14,14 L19,19" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Left" Margin="9,0,0,0" IsHitTestVisible="False"/>
      <TextBlock Text="이름 또는 부서 검색" Foreground="{DynamicResource Muted}" Margin="32,0,0,0" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PeopleSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     </Grid>
     <DockPanel Margin="0,9,0,0"><StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="전체" Style="{StaticResource FilterButton}" Click="FilterAll" Background="{DynamicResource Pale}" Foreground="{DynamicResource Blue}"/><Button x:Name="OnlineFilter" Content="온라인" Style="{StaticResource FilterButton}" Click="FilterOnline" Margin="5,0,0,0"/><Button x:Name="AwayFilter" Content="자리비움" Style="{StaticResource FilterButton}" Click="FilterAway" Margin="5,0,0,0"/></StackPanel></DockPanel>
    </StackPanel></Border>
    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="12,9"><DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="파일" Click="SendFilesClick" FontSize="11" Padding="10,7" Margin="0,0,6,0"/><Button Click="Compose" Style="{StaticResource PrimaryButton}" FontSize="11" Padding="10,7"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}" Width="14" Height="14"/><TextBlock Text="메시지" Margin="6,0,0,0"/></StackPanel></Button></StackPanel>
     <TextBlock x:Name="SelectionHint" Text="선택 0명" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"/>
    </DockPanel></Border>
    <TreeView x:Name="OrganizationTree" Margin="8,9,7,5" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </DockPanel>
  </DockPanel></Border>
  <ScrollViewer x:Name="LoginPanel" Padding="24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center">
   <Image Width="48" Height="48" Source="{StaticResource ProductMark}" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="교무톡"/>
   <TextBlock Text="온라인 교무실" FontSize="26" FontWeight="Bold"/><TextBlock Text="교직원 로그인" Foreground="{DynamicResource Muted}" Margin="0,9,0,22"/>
   <TextBlock Text="우리 학교" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,7"/><DockPanel><Button x:Name="FindServerButton" DockPanel.Dock="Right" Content="학교 검색" Click="FindServerClick" Margin="7,0,0,0" Padding="9,7"/><TextBox x:Name="SchoolSelectionLabel" IsReadOnly="True" Text="학교를 검색해 선택하세요" ToolTip="학교 이름과 지역을 확인하세요"/></DockPanel>
   <TextBlock Text="아이디 · 본인 이름 (동명이인은 학교에서 안내한 이름)" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,7"/><TextBox x:Name="UsernameBox"/>
   <TextBlock Text="비밀번호" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,7"/><PasswordBox x:Name="PasswordBox" KeyDown="PasswordKeyDown"/>
   <CheckBox x:Name="AutoStartCheck" Content="Windows 로그인 시 자동 실행" FontSize="11" Margin="0,17,0,0" Checked="StartupChanged" Unchecked="StartupChanged"/>
   <CheckBox x:Name="RememberLogin" Content="이 Windows 계정에서 자동 로그인" FontSize="11" Margin="0,9,0,0" Checked="RememberChanged" Unchecked="RememberChanged"/>
   <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Click="LoginClick" Margin="0,19,0,12" Padding="10,11"/>
   <Button Content="처음 사용하시나요? 계정 신청" FontSize="11" BorderThickness="0" Foreground="{DynamicResource Blue}" Click="RegisterClick" Padding="7" Margin="0,0,0,9"/>
   <Button Content="화면 색상 · 유리 효과" Click="OpenAppearance" FontSize="11" Padding="7" BorderThickness="0" Background="Transparent" Margin="0,0,0,8"/>
   <Expander Header="연결 도움 · 관리자 안내를 받은 경우" FontSize="11" Margin="0,4,0,10"><StackPanel Margin="0,8,0,0"><TextBlock Text="기존 설치 또는 교내 시험 연결" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/><DockPanel><Button Content="교내 자동검색" DockPanel.Dock="Right" Click="FindNearbyServerClick" Margin="7,0,0,0"/><TextBox x:Name="ServerAddress" TextChanged="ConnectionAddressChanged"/></DockPanel></StackPanel></Expander>
   <TextBlock x:Name="LoginError" Foreground="#AD573C" TextWrapping="Wrap"/><TextBlock Text="학교를 선택한 뒤 본인 이름으로 로그인하세요. 학교마다 계정과 자료는 따로 관리됩니다." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
