<Window x:Class="SchoolMessenger.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="교무톡" Width="440" Height="800" MinWidth="380" MinHeight="580" Style="{StaticResource SchoolWindow}" Closing="WindowClosing">
 <Grid Background="Transparent">
  <DockPanel x:Name="Workspace" Visibility="Collapsed" Background="{DynamicResource Surface}">
   <Border x:Name="NavigationRail" DockPanel.Dock="Left" Width="72" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"><DockPanel x:Name="NavigationLayout" Margin="0,10">
    <Button x:Name="SettingsButton" DockPanel.Dock="Bottom" ToolTip="설정" AutomationProperties.Name="설정" Style="{StaticResource RailButton}" Click="OpenSettings"><StackPanel><Path Data="{StaticResource SettingsIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="설정" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
     <Button.ContextMenu><ContextMenu><MenuItem Header="화면 색상 · 유리 효과" Click="OpenAppearance"/><Separator/><MenuItem x:Name="Quiet" Header="알림 소리 끄기" IsCheckable="True"/><MenuItem x:Name="DoNotDisturb" Header="방해금지" IsCheckable="True"/><MenuItem x:Name="AutoStartMenu" Header="Windows 로그인 시 자동 실행" IsCheckable="True" Checked="StartupChanged" Unchecked="StartupChanged"/><Separator/><MenuItem Header="프로그램 업데이트" Click="OpenDesktopUpdates"/><MenuItem Header="업데이트 내역" Click="OpenUpdates"/><MenuItem Header="오류 신고 · 개선 의견" Click="OpenFeedback"/><MenuItem Header="개인정보 안내" Click="OpenPrivacyNotice"/><MenuItem Header="개인정보 열람·정정·삭제 요청" Click="OpenPrivacyRequest"/><MenuItem Header="내 비밀번호 변경" Click="ChangePassword"/><MenuItem x:Name="AdminButton" Header="교직원 · 서버 관리" Click="OpenAdmin" Visibility="Collapsed"/><Separator/><MenuItem Header="로그아웃" Click="Logout"/><MenuItem Header="프로그램 종료" Click="ExitApp"/></ContextMenu></Button.ContextMenu>
    </Button>
    <StackPanel x:Name="NavigationItems">
     <Button x:Name="OrganizationButton" Style="{StaticResource RailButton}" ToolTip="조직도" AutomationProperties.Name="조직도" Tag="selected" Click="ShowOrganization"><StackPanel><Path Data="{StaticResource TreeIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="조직도" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="FavoritesButton" Style="{StaticResource RailButton}" ToolTip="즐겨찾기" AutomationProperties.Name="즐겨찾기" Click="ToggleFavorites"><StackPanel><Path Data="{StaticResource StarIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="즐겨찾기" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" ToolTip="받은함" AutomationProperties.Name="받은함" Tag="received" Click="OpenMailboxClick"><StackPanel><Grid HorizontalAlignment="Center"><Path Data="{StaticResource MailIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><Border x:Name="ReceivedBadge" Visibility="Collapsed" Background="{DynamicResource Danger}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-9,0"><TextBlock x:Name="ReceivedBadgeText" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid><TextBlock Text="받은함" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button Style="{StaticResource RailButton}" ToolTip="보낸함" AutomationProperties.Name="보낸함" Tag="sent" Click="OpenMailboxClick"><StackPanel><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="보낸함" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="ChatButton" Style="{StaticResource RailButton}" ToolTip="채팅" AutomationProperties.Name="채팅" Click="OpenChatClick"><StackPanel><Path Data="{StaticResource ChatIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="채팅" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="WorkButton" Style="{StaticResource RailButton}" ToolTip="할 일 · 파일 제출" AutomationProperties.Name="할 일 · 파일 제출" Click="OpenWorkClick"><StackPanel><Path Data="{StaticResource FileIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="할 일" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="SurveyButton" Style="{StaticResource RailButton}" ToolTip="설문" AutomationProperties.Name="설문" Click="OpenSurveyClick"><StackPanel><Path Data="{StaticResource SurveyIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="설문" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="TimetableButton" Style="{StaticResource RailButton}" ToolTip="시간표" AutomationProperties.Name="시간표" Visibility="Collapsed" Click="OpenTimetableClick"><StackPanel><Path Data="{StaticResource TimetableIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="시간표" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
     <Button x:Name="OfficeButton" Style="{StaticResource RailButton}" ToolTip="학사일정 · 특별실 예약" AutomationProperties.Name="학사일정 · 특별실 예약" Click="OpenOfficeClick"><StackPanel><Path Data="{StaticResource CalendarIcon}" Style="{StaticResource Glyph}" Width="22" Height="22"/><TextBlock Text="일정" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel></Button>
    </StackPanel>
   </DockPanel></Border>
   <Border DockPanel.Dock="Top" Padding="16,16,10,12">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentControl x:Name="IdentityDot" VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="IdentityLabel" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock x:Name="IdentityDepartment" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="170"/><TextBlock Text=" · " Foreground="{DynamicResource Faint}" FontSize="11"/><TextBlock x:Name="IdentityStatus" Text="연결 중" Foreground="{DynamicResource Muted}" FontSize="11"/></StackPanel></StackPanel>
     <Button x:Name="UnreadShortcut" Grid.Column="2" Tag="unread" Click="OpenMailboxClick" Style="{StaticResource FormatButton}" Padding="8,6" VerticalAlignment="Center" ToolTip="안 읽은 메시지" AutomationProperties.Name="안 읽은 메시지"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource BellOn}" Style="{StaticResource Glyph}"/><TextBlock x:Name="UnreadCount" Text="0" FontSize="12" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
    </Grid>
   </Border>
   <Border DockPanel.Dock="Bottom" Padding="16,0,14,8"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ConnectionLabel" Text="서버 연결 확인 중" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="RosterHint" Grid.Column="1" Visibility="Collapsed"/></Grid>
    <TextBlock x:Name="StatusLabel" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel></Border>
   <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,10,14,8"><DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Click="SendFilesClick" Margin="0,0,8,0" Padding="12,7" AutomationProperties.Name="파일 보내기"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AttachIcon}" Style="{StaticResource Glyph}" Width="15" Height="15"/><TextBlock Text="파일" Margin="6,0,0,0"/></StackPanel></Button><Button Click="Compose" Style="{StaticResource PrimaryButton}" Padding="12,7" AutomationProperties.Name="메시지 보내기"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource SendIcon}" Style="{StaticResource Glyph}" Width="15" Height="15"/><TextBlock Text="메시지 보내기" Margin="6,0,0,0"/></StackPanel></Button></StackPanel>
    <TextBlock x:Name="SelectionHint" Text="0명 선택" Foreground="{DynamicResource Blue}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
   </DockPanel></Border>
   <StackPanel DockPanel.Dock="Top" Margin="16,0,14,8">
    <Grid><TextBox x:Name="PeopleSearch" ToolTip="이름 · 부서 · 폴더 검색" AutomationProperties.Name="교직원 검색" TextChanged="SearchPeople" Padding="32,8,8,8" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Soft}"/>
     <Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource Faint}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
     <TextBlock Text="이름 · 부서 · 폴더 검색" Foreground="{DynamicResource Faint}" Margin="34,0,0,0" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PeopleSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <DockPanel Margin="0,10,0,-4"><Button x:Name="SortButton" DockPanel.Dock="Right" Content="이름순 ↕" Style="{StaticResource FormatButton}" FontSize="11" Padding="4,4" Click="ToggleSort" VerticalAlignment="Top"/><WrapPanel><TextBlock x:Name="RosterTitle" Text="교직원" Visibility="Collapsed"/><Button x:Name="AllFilter" Content="전체" Style="{StaticResource FilterButton}" Click="FilterAll" Background="{DynamicResource Blue}" BorderBrush="{DynamicResource Blue}" Foreground="{DynamicResource OnAccent}" Margin="0,0,6,4"/><Button x:Name="OnlineFilter" Content="온라인" Style="{StaticResource FilterButton}" Click="FilterOnline" Margin="0,0,6,4"/><Button x:Name="AwayFilter" Content="자리비움" Style="{StaticResource FilterButton}" Click="FilterAway" Margin="0,0,6,4"/></WrapPanel></DockPanel>
   </StackPanel>
   <Grid>
    <Border x:Name="RosterEmpty" Visibility="Collapsed" Margin="16,8,14,0" VerticalAlignment="Top">
     <StackPanel HorizontalAlignment="Center" Margin="0,24,0,0"><ContentControl x:Name="RosterEmptyArt" Focusable="False"/><TextBlock x:Name="RosterEmptyTitle" FontWeight="SemiBold" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"/><TextBlock x:Name="RosterEmptyDescription" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <TreeView x:Name="OrganizationTree" Margin="10,0,8,4" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
   </Grid>
  </DockPanel>
  <ScrollViewer x:Name="LoginPanel" Padding="28,20" Background="{DynamicResource Surface}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel VerticalAlignment="Center">
   <Image Width="56" Height="56" Source="{StaticResource ProductMark}" HorizontalAlignment="Left" Margin="0,8,0,18" AutomationProperties.Name="교무톡"/>
   <TextBlock Text="교무톡" FontSize="28" FontWeight="Bold"/><TextBlock Text="교직원 메신저에 로그인하세요" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,6,0,24"/>
   <StackPanel x:Name="SchoolField" Margin="0,0,0,15"><TextBlock Text="학교" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,7"/><Grid><TextBox x:Name="SchoolSearch" AutomationProperties.Name="학교 찾기" Padding="32,6,8,6"/><Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource Faint}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/></Grid></StackPanel>
   <TextBlock Text="학교 서버 주소" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,7"/><DockPanel><Button x:Name="FindServerButton" DockPanel.Dock="Right" Content="교내 자동검색" Click="FindNearbyServerClick" Margin="7,0,0,0" Padding="9,7"/><TextBox x:Name="ServerAddress" TextChanged="ConnectionAddressChanged" AutomationProperties.Name="학교 서버 주소"/></DockPanel>
   <TextBlock Text="관리자가 알려준 주소를 넣거나 ‘교내 자동검색’을 누르세요." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock Text="이름" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,7"/><TextBox x:Name="UsernameBox" AutomationProperties.Name="이름"/>
   <TextBlock Text="본인 이름을 넣으세요. 예전에 영문 아이디로 신청한 계정은 그 아이디로도 로그인됩니다." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
   <TextBlock Text="비밀번호" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,15,0,7"/><PasswordBox x:Name="PasswordBox" KeyDown="PasswordKeyDown"/>
   <CheckBox x:Name="AutoStartCheck" Content="Windows 로그인 시 자동 실행" FontSize="11" Margin="0,17,0,0" Checked="StartupChanged" Unchecked="StartupChanged"/>
   <CheckBox x:Name="RememberLogin" Content="이 Windows 계정에서 자동 로그인" FontSize="11" Margin="0,9,0,0" Checked="RememberChanged" Unchecked="RememberChanged"/>
   <Button x:Name="LoginButton" Content="로그인" Style="{StaticResource PrimaryButton}" Click="LoginClick" Margin="0,20,0,12" Padding="10,11" FontSize="14"/>
   <Button Content="처음 사용하시나요? 계정 신청" FontSize="11" BorderThickness="0" Foreground="{DynamicResource Blue}" Click="RegisterClick" Padding="7" Margin="0,0,0,9"/>
   <TextBlock x:Name="LoginError" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/><TextBlock Text="학교마다 계정과 자료는 따로 관리됩니다." FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid>
</Window>
