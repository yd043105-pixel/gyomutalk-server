 <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="BorderBrush" Value="{DynamicResource DangerLine}"/><Setter Property="Foreground" Value="{DynamicResource Danger}"/></Style>
