<Window x:Class="SchoolMessenger.Desktop.ComposeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SchoolMessenger.Desktop" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="DropFiles"
 Title="교무톡 · 메시지 보내기" Width="740" Height="660" MinWidth="640" MinHeight="550" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
 <DockPanel Background="{DynamicResource Surface}" Margin="16,12">
  <StackPanel Visibility="Collapsed"><TextBox x:Name="PeopleSearch"/><CheckBox x:Name="FavoritesOnly"/><ComboBox x:Name="Department"/><CheckBox x:Name="SendAll"/><ListBox x:Name="PeopleList"/></StackPanel>

  <StackPanel DockPanel.Dock="Top">
   <DockPanel Margin="0,0,0,7"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="SelfButton" Content="나에게 전송" Click="SendToSelf" FontSize="11" Padding="9,5" Margin="0,0,6,0"/><Button x:Name="RecipientsButton" Content="수신자 추가" Click="ChooseRecipients" FontSize="11" Padding="9,5"/></StackPanel><TextBlock x:Name="RecipientCount" Text="받는 사람" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource Soft}" Padding="5"><ScrollViewer x:Name="RecipientScroller" Height="54" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="RecipientChips"/></ScrollViewer></Border>
   <DockPanel Margin="0,10,0,7"><TextBlock Text="제목 · 선택" Width="70" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBox x:Name="TitleBox" MaxLength="200" ToolTip="비워 두면 본문 앞부분이 제목으로 표시됩니다."/></DockPanel>
   <StackPanel x:Name="DeliveryOptions" Orientation="Horizontal" TextElement.FontSize="11" Margin="0,0,0,8">
    <CheckBox x:Name="CollectFiles" Content="파일 제출 요청" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="SubmissionDate" Width="114" FontSize="11" ToolTip="제출 마감 · 한국 시간 해당일 23:59까지"/>
    <CheckBox x:Name="ScheduleSend" Content="예약 전송" VerticalAlignment="Center" Margin="14,0,6,0" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/><DatePicker x:Name="ScheduleDate" Width="114" FontSize="11" IsEnabled="False"/><TextBox x:Name="ScheduleTime" Text="09:00" Width="54" MaxLength="5" Margin="5,0,0,0" Padding="5" IsEnabled="False" ToolTip="한국 시간 · HH:mm"/><TextBlock Text="한국 시간" Foreground="{DynamicResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0"/>
   </StackPanel>
   <WrapPanel x:Name="FormattingToolbar" Margin="0,0,0,7">
    <ComboBox x:Name="FontChoice" Width="130" FontSize="11" ToolTip="이 컴퓨터에 설치된 글꼴" SelectionChanged="FontChanged" Margin="0,0,5,0"/>
    <ComboBox x:Name="SizeChoice" Width="52" FontSize="11" ToolTip="글자 크기 · pt" SelectionChanged="FontSizeChanged" Margin="0,0,5,0"/>
    <Button Content="B" FontWeight="Bold" ToolTip="굵게 · Ctrl+B" Click="BoldText" Focusable="False" Padding="8,6" Margin="0,0,3,0"/>
    <Button Content="I" FontStyle="Italic" ToolTip="기울임 · Ctrl+I" Click="ItalicText" Focusable="False" Padding="8,6" Margin="0,0,3,0"/>
    <Button Content="U" ToolTip="밑줄 · Ctrl+U" Click="UnderlineText" Focusable="False" Padding="8,6" Margin="0,0,3,0"/>
    <Button Content="S" ToolTip="취소선" Click="StrikeText" Focusable="False" Padding="8,6" Margin="0,0,5,0"/>
    <ComboBox x:Name="ColorChoice" Width="66" FontSize="10" ToolTip="글자 색" SelectionChanged="ColorChanged" Margin="0,0,5,0"/>
    <ComboBox x:Name="HighlightChoice" Width="70" FontSize="10" ToolTip="배경 강조" SelectionChanged="HighlightChanged" Margin="0,0,5,0"/>
    <Button Content="지우기" ToolTip="선택한 글자의 서식 지우기" Click="ClearFormatting" Focusable="False" FontSize="10" Padding="7,6"/>
   </WrapPanel>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom">
   <TextBlock x:Name="Feedback" Foreground="#A05B24" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,5"/>
   <DockPanel><Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Send" FontSize="12" Padding="15,8" Content="보내기"/><StackPanel Orientation="Horizontal"><Button x:Name="DraftButton" Content="임시저장" Click="SaveDraftClick" FontSize="11" Padding="9,7"/><Button x:Name="DraftListButton" Content="임시저장 목록" Click="ShowDrafts" FontSize="10" Padding="8,7" Margin="6,0,0,0"/><Button Content="삭제" Click="DiscardDraft" FontSize="10" Padding="8,7" Margin="6,0,0,0"/><Button Content="예약 목록" Click="ShowScheduled" FontSize="10" Padding="8,7" Margin="6,0,0,0"/></StackPanel></DockPanel>
   <TextBlock Text="창을 닫아도 자동 임시저장됩니다." Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,5,0,0"/>
  </StackPanel>
  <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,5">
   <DockPanel Margin="0,0,0,6"><Button x:Name="RemoveButton" DockPanel.Dock="Right" Content="선택 제거" Click="RemoveFile" FontSize="10" Padding="7,5"/><Button x:Name="AddButton" Click="AddFiles" Content="파일 첨부" FontSize="11" Padding="9,5" HorizontalAlignment="Left"/></DockPanel>
   <Border Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8"><Grid>
    <TextBlock Text="파일을 이곳이나 본문에 끌어다 놓으세요." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=FilesList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    <ListBox x:Name="FilesList" Height="48" DisplayMemberPath="Description" Background="Transparent"/>
   </Grid></Border>
   <TextBlock Text="파일당 100MB · 합계 200MB · 최대 10개 · 업로드 후 30일 보관" Foreground="{DynamicResource Muted}" FontSize="10" Margin="0,4,0,0"/>
  </StackPanel>
  <local:MessageEditor x:Name="BodyBox" VerticalScrollBarVisibility="Auto" MaxLength="20000" AllowDrop="True" Margin="0,0,0,10" Padding="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Background="{DynamicResource Surface}"/>
 </DockPanel>
</Window>
