<Window x:Class="SchoolMessenger.Desktop.ComposeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SchoolMessenger.Desktop" AllowDrop="True" PreviewDragOver="FilesDragOver" PreviewDrop="DropFiles"
 Title="교무톡 · 메시지 보내기" Width="780" Height="720" MinWidth="640" MinHeight="560" FontSize="13" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner" Closing="WindowClosing">
 <DockPanel Background="{DynamicResource Surface}">
  <StackPanel Visibility="Collapsed"><TextBox x:Name="PeopleSearch"/><CheckBox x:Name="FavoritesOnly"/><ComboBox x:Name="Department"/><CheckBox x:Name="SendAll"/><ListBox x:Name="PeopleList"/></StackPanel>

  <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="24,12">
   <DockPanel>
    <Button x:Name="SendButton" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="Send" Padding="20,6" Content="보내기"/>
    <TextBlock DockPanel.Dock="Right" Text="창을 닫아도 자동 임시저장됩니다." Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="DraftButton" Content="임시저장" Click="SaveDraftClick" Style="{StaticResource SubtleButton}"/>
     <Button x:Name="DraftListButton" Content="임시저장 목록" Click="ShowDrafts" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"/>
     <Button Content="삭제" Click="DiscardDraft" Style="{StaticResource SubtleButton}" Foreground="{DynamicResource Danger}" Margin="4,0,0,0"/>
     <Button Content="예약 목록" Click="ShowScheduled" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>

  <Grid Margin="24,16,24,12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="92"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

   <TextBlock x:Name="RecipientCount" Text="받는 사람" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,8,0"/>
   <StackPanel Grid.Column="1" Margin="0,0,0,12">
    <DockPanel>
     <Button x:Name="RecipientsButton" DockPanel.Dock="Right" Click="ChooseRecipients" Margin="12,0,0,0" VerticalAlignment="Top" AutomationProperties.Name="수신자 추가"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource TreeIcon}" Style="{StaticResource Glyph}" Width="15" Height="15"/><TextBlock Text="조직도에서 선택" Margin="6,0,0,0"/></StackPanel></Button>
     <Border BorderBrush="{DynamicResource LineStrong}" BorderThickness="1" CornerRadius="8" Padding="6,3" MinHeight="36"><ScrollViewer x:Name="RecipientScroller" MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="RecipientChips"/></ScrollViewer></Border>
    </DockPanel>
    <CheckBox x:Name="SelfBox" Content="나에게도 보내기" Checked="SendToSelf" Unchecked="SendToSelf" Margin="0,8,0,0" HorizontalAlignment="Left"/>
   </StackPanel>

   <TextBlock Grid.Row="1" Text="제목" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Top" Margin="0,8,0,0"/>
   <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" MaxLength="200" AutomationProperties.Name="제목" ToolTip="비워 두면 본문 앞부분이 제목으로 표시됩니다." Margin="0,0,0,12"/>

   <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10">
    <DockPanel>
     <Border DockPanel.Dock="Top" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" CornerRadius="10,10,0,0" Padding="8,6">
      <WrapPanel x:Name="FormattingToolbar">
       <ComboBox x:Name="FontChoice" Width="124" FontSize="12" ToolTip="이 컴퓨터에 설치된 글꼴" SelectionChanged="FontChanged" Margin="0,0,4,0"/>
       <ComboBox x:Name="SizeChoice" Width="60" FontSize="12" ToolTip="글자 크기 · pt" SelectionChanged="FontSizeChanged" Margin="0,0,8,0"/>
       <Button Content="B" FontWeight="Bold" ToolTip="굵게 · Ctrl+B" Click="BoldText" Focusable="False" Style="{StaticResource FormatButton}"/>
       <Button Content="I" FontStyle="Italic" ToolTip="기울임 · Ctrl+I" Click="ItalicText" Focusable="False" Style="{StaticResource FormatButton}"/>
       <Button Content="U" ToolTip="밑줄 · Ctrl+U" Click="UnderlineText" Focusable="False" Style="{StaticResource FormatButton}"/>
       <Button Content="S" ToolTip="취소선" Click="StrikeText" Focusable="False" Style="{StaticResource FormatButton}" Margin="0,0,8,0"/>
       <ComboBox x:Name="ColorChoice" MinWidth="92" FontSize="12" ToolTip="글자 색" SelectionChanged="ColorChanged" Margin="0,0,4,0"/>
       <ComboBox x:Name="HighlightChoice" MinWidth="92" FontSize="12" ToolTip="배경 강조" SelectionChanged="HighlightChanged" Margin="0,0,4,0"/>
       <Button Content="지우기" ToolTip="선택한 글자의 서식 지우기" Click="ClearFormatting" Focusable="False" Style="{StaticResource FormatButton}" FontSize="12"/>
      </WrapPanel>
     </Border>
     <local:MessageEditor x:Name="BodyBox" VerticalScrollBarVisibility="Auto" MaxLength="20000" AllowDrop="True" Padding="12" BorderThickness="0" Background="Transparent"/>
    </DockPanel>
   </Border>

   <WrapPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0">
    <Button x:Name="AddButton" Click="AddFiles" Margin="0,0,8,6" AutomationProperties.Name="파일 첨부"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AttachIcon}" Style="{StaticResource Glyph}" Width="15" Height="15"/><TextBlock Text="파일 첨부" Margin="6,0,0,0"/></StackPanel></Button>
    <ItemsControl x:Name="FilesList"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
     <Border Background="{DynamicResource Pale}" CornerRadius="16" Padding="10,0,4,0" Margin="0,0,8,6" MinHeight="32"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource FolderIcon}" Stroke="{DynamicResource Blue}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Description}" ToolTip="{Binding Path}" FontSize="12" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding SizeLabel}" Foreground="{DynamicResource Faint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
      <Button Content="×" Tag="{Binding}" Click="RemoveFile" ToolTip="첨부에서 빼기" AutomationProperties.Name="첨부에서 빼기" BorderThickness="0" Background="Transparent" Padding="0" MinHeight="24" Width="24" Height="24" Margin="4,0,0,0" Foreground="{DynamicResource Muted}" HorizontalContentAlignment="Center"/>
     </StackPanel></Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock x:Name="AttachmentHint" TextWrapping="Wrap" Foreground="{DynamicResource Faint}" FontSize="11" VerticalAlignment="Center" Margin="0,0,0,6"/>
   </WrapPanel>

   <WrapPanel x:Name="DeliveryOptions" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,4,0,0">
    <StackPanel Orientation="Horizontal" Margin="0,0,24,4"><CheckBox x:Name="CollectFiles" Content="파일 제출 받기 · 마감" Checked="CollectChanged" Unchecked="CollectChanged" VerticalAlignment="Center" Margin="0,0,8,0"/><DatePicker x:Name="SubmissionDate" Width="128" IsEnabled="False" ToolTip="제출 마감 · 한국 시간 해당일 23:59까지"/></StackPanel>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,4"><CheckBox x:Name="ScheduleSend" Content="예약 전송" VerticalAlignment="Center" Margin="0,0,8,0" Checked="ScheduleChanged" Unchecked="ScheduleChanged"/><DatePicker x:Name="ScheduleDate" Width="128" IsEnabled="False"/><TextBox x:Name="ScheduleTime" Text="09:00" Width="60" MaxLength="5" Margin="6,0,0,0" IsEnabled="False" ToolTip="한국 시간 · HH:mm"/></StackPanel>
   </WrapPanel>

   <TextBlock x:Name="Feedback" Grid.Row="5" Grid.ColumnSpan="2" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
  </Grid>
 </DockPanel>
</Window>
