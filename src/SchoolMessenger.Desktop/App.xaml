<Application x:Class="SchoolMessenger.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 ><Application.Resources>
 <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
  <DrawingImage x:Key="ProductMark"><DrawingImage.Drawing><DrawingGroup>
   <!-- Same artwork as Shared/Branding/brand_mark.svg -->
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" RadiusX="29" RadiusY="29"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Geometry="M64 36V14"><GeometryDrawing.Pen><Pen Brush="White" Thickness="4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#FFC94A" Geometry="M66 13H85L79.5 19L85 25H66Z"><GeometryDrawing.Pen><Pen Brush="#FFC94A" Thickness="2" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="White" Geometry="M32 64H96V88Q96 98 86 98H60L42 111V98H42Q32 98 32 88Z"><GeometryDrawing.Pen><Pen Brush="White" Thickness="8" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#A9D9EC" Geometry="M22 64L64 37L106 64Z"><GeometryDrawing.Pen><Pen Brush="#A9D9EC" Thickness="6" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="49,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="64,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="79,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <!-- The administrator and server program: the same mark with a server badge (Shared/Branding/admin_mark.svg). -->
  <DrawingImage x:Key="AdminMark"><DrawingImage.Drawing><DrawingGroup ClipGeometry="M0,0 H128 V128 H0 Z">
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" RadiusX="29" RadiusY="29"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Geometry="M64 36V14"><GeometryDrawing.Pen><Pen Brush="White" Thickness="4" StartLineCap="Round" EndLineCap="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#FFC94A" Geometry="M66 13H85L79.5 19L85 25H66Z"><GeometryDrawing.Pen><Pen Brush="#FFC94A" Thickness="2" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="White" Geometry="M32 64H96V88Q96 98 86 98H60L42 111V98H42Q32 98 32 88Z"><GeometryDrawing.Pen><Pen Brush="White" Thickness="8" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#A9D9EC" Geometry="M22 64L64 37L106 64Z"><GeometryDrawing.Pen><Pen Brush="#A9D9EC" Thickness="6" LineJoin="Round"/></GeometryDrawing.Pen></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="49,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="64,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#2463EB"><GeometryDrawing.Geometry><EllipseGeometry Center="79,82" RadiusX="5.5" RadiusY="5.5"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><EllipseGeometry Center="100,100" RadiusX="27" RadiusY="27"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#12306B"><GeometryDrawing.Geometry><EllipseGeometry Center="100,100" RadiusX="22" RadiusY="22"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="88,87,24,10.5" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="White"><GeometryDrawing.Geometry><RectangleGeometry Rect="88,102.5,24,10.5" RadiusX="3" RadiusY="3"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#12306B"><GeometryDrawing.Geometry><EllipseGeometry Center="94,92.25" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="#12306B"><GeometryDrawing.Geometry><EllipseGeometry Center="94,107.75" RadiusX="2" RadiusY="2"/></GeometryDrawing.Geometry></GeometryDrawing>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style x:Key="SchoolWindow" TargetType="Window">
   <Setter Property="Icon" Value="/Assets/brand_mark.ico"/>
   <Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Surface}"/>
   <Setter Property="WindowStyle" Value="None"/><Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
    <Border x:Name="Frame" Background="{TemplateBinding Background}">
     <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Glass}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
       <Grid Margin="13,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Image Width="27" Height="27" Source="{DynamicResource ProductMark}" HorizontalAlignment="Left" AutomationProperties.Name="교무톡"/>
        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
         <Button x:Name="MinimizeAction" Style="{StaticResource ChromeButton}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="MinimizeWindow"><Path Data="M0,0 L10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1" Width="10"/></Button>
         <Button x:Name="MaximizeAction" Style="{StaticResource ChromeButton}" ToolTip="최대화 · 복원" AutomationProperties.Name="최대화 또는 복원" Click="MaximizeWindow"><Rectangle Width="9" Height="9" Stroke="{DynamicResource Muted}" StrokeThickness="1"/></Button>
         <Button x:Name="CloseAction" Style="{StaticResource ChromeButton}" ToolTip="닫기" AutomationProperties.Name="닫기" Click="CloseWindow"><Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1" Width="9" Height="9"/></Button>
        </StackPanel>
       </Grid>
      </Border>
      <AdornerDecorator Grid.Row="1"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator>
     </Grid>
    </Border>
   <ControlTemplate.Triggers><Trigger Property="ResizeMode" Value="NoResize"><Setter TargetName="MinimizeAction" Property="Visibility" Value="Collapsed"/><Setter TargetName="MaximizeAction" Property="Visibility" Value="Collapsed"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
 </Application.Resources></Application>
