<Application x:Class="SchoolMessenger.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 ><Application.Resources>
 <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries>
  <DrawingImage x:Key="ProductMark"><DrawingImage.Drawing><DrawingGroup>
   <GeometryDrawing Brush="#245BC6"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,128,128" RadiusX="28" RadiusY="28"/></GeometryDrawing.Geometry></GeometryDrawing>
   <GeometryDrawing Brush="White" Geometry="M40 30H88Q100 30 100 42V77Q100 89 88 89H61L44 101V89H40Q28 89 28 77V42Q28 30 40 30Z"/>
   <GeometryDrawing Brush="#245BC6" Geometry="M43 46Q54 42 62 48V72Q52 66 43 70Z M66 48Q75 42 85 46V70Q76 66 66 72Z"/>
  </DrawingGroup></DrawingImage.Drawing></DrawingImage>
  <Style TargetType="ContextMenu">
   <Setter Property="Background" Value="{DynamicResource Glass}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="4"/>
   <Setter Property="HasDropShadow" Value="True"/>
  </Style>
  <Style TargetType="MenuItem">
   <Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="8,5"/>
  </Style>
  <Style x:Key="SchoolWindow" TargetType="Window">
   <Setter Property="Icon" Value="/Assets/brand_mark.ico"/>
   <Setter Property="FontFamily" Value="Malgun Gothic"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Canvas}"/>
   <Setter Property="WindowStyle" Value="None"/><Setter Property="UseLayoutRounding" Value="True"/>
   <Setter Property="shell:WindowChrome.WindowChrome"><Setter.Value><shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Window">
    <Border x:Name="Frame" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource GlassLine}" BorderThickness="1" CornerRadius="11">
     <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition/></Grid.RowDefinitions>
      <Border Background="{DynamicResource Glass}" CornerRadius="10,10,0,0" BorderBrush="{DynamicResource GlassLine}" BorderThickness="0,0,0,1">
       <Grid Margin="13,0,6,0"><Grid.ColumnDefinitions><ColumnDefinition Width="35"/><ColumnDefinition/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
        <Image Width="27" Height="27" Source="{StaticResource ProductMark}" HorizontalAlignment="Left" AutomationProperties.Name="교무톡"/>
        <TextBlock Grid.Column="1" Text="{TemplateBinding Title}" Foreground="{DynamicResource Ink}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
         <Button x:Name="MinimizeAction" Style="{StaticResource ChromeButton}" ToolTip="최소화" AutomationProperties.Name="최소화" Click="MinimizeWindow"><Path Data="M0,0 L10,0" Stroke="{DynamicResource Muted}" StrokeThickness="1" Width="10"/></Button>
         <Button x:Name="MaximizeAction" Style="{StaticResource ChromeButton}" ToolTip="최대화 · 복원" AutomationProperties.Name="최대화 또는 복원" Click="MaximizeWindow"><Rectangle Width="9" Height="9" Stroke="{DynamicResource Muted}" StrokeThickness="1"/></Button>
         <Button x:Name="CloseAction" Style="{StaticResource ChromeButton}" ToolTip="닫기" AutomationProperties.Name="닫기" Click="CloseWindow"><Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{DynamicResource Muted}" StrokeThickness="1" Width="9" Height="9"/></Button>
        </StackPanel>
       </Grid>
      </Border>
      <AdornerDecorator Grid.Row="1"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></AdornerDecorator>
     </Grid>
    </Border><ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="Frame" Property="CornerRadius" Value="0"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </ResourceDictionary>
 </Application.Resources></Application>
