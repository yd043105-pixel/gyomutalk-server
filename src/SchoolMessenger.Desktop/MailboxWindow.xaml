<Window x:Class="SchoolMessenger.Desktop.MailboxWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SchoolMessenger.Desktop"
 Title="교무톡 · 메시지함" Width="940" Height="660" MinWidth="650" MinHeight="520" FontSize="13" Style="{StaticResource SchoolWindow}" WindowStartupLocation="CenterOwner">
 <DockPanel Background="{DynamicResource Surface}">
  <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,16,20,0">
   <StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="NewMessage" VerticalAlignment="Center" AutomationProperties.Name="새 메시지"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource AddIcon}" Style="{StaticResource Glyph}" Width="13" Height="13"/><TextBlock Text="새 메시지" Margin="6,0,0,0"/></StackPanel></Button><StackPanel Margin="0,0,8,0"><TextBlock x:Name="BoxTitle" Text="메시지함" FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis"/><TextBlock Text="받은 메시지와 보낸 기록" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,3,0,0"/></StackPanel></DockPanel>
    <StackPanel Orientation="Horizontal" Margin="-4,4,0,0"><Button x:Name="ReceivedTab" Style="{StaticResource TabButton}" Content="받은 메시지" Uid="received" Click="ChangeBox"/><Button x:Name="UnreadTab" Style="{StaticResource TabButton}" Content="미확인" Uid="unread" Click="ChangeBox"/><Button x:Name="SentTab" Style="{StaticResource TabButton}" Content="보낸 메시지" Uid="sent" Click="ChangeBox"/></StackPanel>
   </StackPanel>
  </Border>
  <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,6"><DockPanel><TextBlock x:Name="StatusLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Right" FontSize="11" MaxWidth="460" Margin="16,0,0,0"/><TextBlock x:Name="ConnectionLabel" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="250"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition x:Name="ListRow"/><RowDefinition x:Name="EmptyRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="ListPane" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="12">
    <DockPanel>
     <StackPanel x:Name="SearchTools" DockPanel.Dock="Top" Margin="2,3,2,9">
      <Grid><TextBox x:Name="SearchBox" ToolTip="제목·본문·보낸 사람 검색" AutomationProperties.Name="제목·본문·보낸 사람 검색" KeyDown="SearchKeyDown" Padding="32,8,8,8" Background="{DynamicResource Soft}" BorderBrush="{DynamicResource Soft}"/>
       <Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource Faint}" StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Left" Margin="11,0,0,0" IsHitTestVisible="False"/>
       <TextBlock Text="제목 · 본문 · 보낸 사람" Foreground="{DynamicResource Faint}" Margin="34,0,0,0" FontSize="12" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
      <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><DatePicker x:Name="FromDate" ToolTip="시작 날짜" FontSize="12" Margin="0,0,3,0"/><DatePicker x:Name="ToDate" Grid.Column="1" ToolTip="종료 날짜" FontSize="12" Margin="3,0,6,0"/><Button Grid.Column="2" Click="RefreshClick" ToolTip="검색 · 새로고침" AutomationProperties.Name="검색 · 새로고침" Width="34" Padding="0" HorizontalContentAlignment="Center"><Path Data="{StaticResource RefreshIcon}" Style="{StaticResource Glyph}" Width="15" Height="15"/></Button></Grid>
     </StackPanel>
     <StackPanel x:Name="ListFooter" DockPanel.Dock="Bottom" Margin="2,8,2,0"><TextBlock x:Name="ListHint" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6"/><Button x:Name="MoreMessages" Content="이전 메시지 더 보기" Click="LoadMore" Style="{StaticResource SubtleButton}"/></StackPanel>
     <ListBox x:Name="MessageList" Background="Transparent" SelectionChanged="SelectMessage" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Width="36" Height="36" CornerRadius="18" Background="{Binding AvatarBack}" VerticalAlignment="Top" Margin="0,2,12,0"><TextBlock Text="{Binding Initial}" Foreground="{Binding AvatarInk}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
       <StackPanel Grid.Column="1">
        <DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding Date}" FontSize="11" Foreground="{DynamicResource Faint}" Margin="8,0,0,0"/><Path DockPanel.Dock="Right" Data="{StaticResource AttachIcon}" Stroke="{DynamicResource Faint}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0" ToolTip="{Binding FilesLabel}"><Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasFiles}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style></Path><TextBlock Text="{Binding SenderName}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/></DockPanel>
        <DockPanel Margin="0,3,0,0"><Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="{DynamicResource Blue}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="미확인"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsUnread}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding DisplayTitle}" ToolTip="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DockPanel>
        <TextBlock Text="{Binding PreviewLine}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding PreviewLine}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        <TextBlock Text="{Binding SentLabel}" Foreground="{DynamicResource Blue}" FontSize="11" FontWeight="SemiBold" Margin="0,3,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding SentLabel}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
       </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid x:Name="ReaderPane" Grid.Column="1" Margin="24,20,24,16">
    <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="EmptyHint" VerticalAlignment="Center" MaxWidth="500" Padding="16,24">
     <StackPanel><ContentControl x:Name="EmptyArt" Focusable="False"/><TextBlock x:Name="MailboxEmptyTitle" Text="메시지를 선택하세요" TextAlignment="Center" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="MailboxEmptyDescription" Text="본문과 첨부파일을 확인할 수 있습니다." Margin="0,6,0,0" Foreground="{DynamicResource Muted}" TextAlignment="Center" FontSize="12" TextWrapping="Wrap"/></StackPanel>
    </Border>
    <ScrollViewer x:Name="DetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="DetailTitle" FontSize="20" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,0,12"/>
     <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="0,0,0,15" Margin="0,0,0,20"><DockPanel><Border x:Name="ReceiptPill" DockPanel.Dock="Right" Background="{DynamicResource Pale}" CornerRadius="11" Padding="9,3" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Name="ReceiptPillText" Foreground="{DynamicResource Blue}" FontSize="11" FontWeight="Bold"/></Border><ContentControl x:Name="DetailAvatar" Focusable="False" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock x:Name="DetailMeta" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/></DockPanel></Border>
     <StackPanel x:Name="TaskPrompt" Visibility="Collapsed" Margin="0,0,0,20" AutomationProperties.Name="메시지에서 찾은 할 일">
      
      <Border Background="{DynamicResource Pale}" CornerRadius="10" Padding="16">
       <StackPanel>
        <TextBlock x:Name="TaskPromptTitle" Text="할 일에 추가할까요?" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock Text="내용과 기한을 확인하고 추가할 항목을 선택하세요." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,10"/>
        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TaskCandidateList"/></ScrollViewer>
        <WrapPanel x:Name="TaskPromptActions" Margin="0,10,0,0">
         <Button x:Name="AddSuggestedTasks" Content="추가하기" Style="{StaticResource PrimaryButton}" Click="AddTasks" Margin="0,0,8,4"/>
         <Button Content="추가 안 함" Click="DismissTasks" Margin="0,0,0,4"/>
        </WrapPanel>
        <TextBlock x:Name="TaskPromptFeedback" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <local:MessageBody x:Name="DetailBody" TextWrapping="Wrap" FontSize="13"/>
     <Button x:Name="RecallButton" Content="메시지 회수" Click="Recall" Visibility="Collapsed" HorizontalAlignment="Left" FontSize="11" Margin="0,16,0,14"/>
     <Button x:Name="SubmissionButton" Content="파일 제출 · 현황 보기" Click="OpenSubmission" Visibility="Collapsed" HorizontalAlignment="Left" FontSize="11" Margin="0,16,0,14"/>
     <TextBlock x:Name="AttachmentHeader" Text="첨부파일" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,16,0,9"/>
     <ItemsControl x:Name="FileList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,8" MaxWidth="420" HorizontalAlignment="Left"><StackPanel>
      <Button IsEnabled="{Binding Available}" Tag="{Binding}" Click="Download" AutomationProperties.Name="{Binding Description}" ToolTip="받기" HorizontalContentAlignment="Left" BorderThickness="0" Background="Transparent" Padding="2,3"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Pale}" Margin="0,0,10,0"><Path Data="{StaticResource FileIcon}" Stroke="{DynamicResource Blue}" StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16" Stretch="Uniform"/></Border><TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center"/><Path Grid.Column="2" Data="{StaticResource DownloadIcon}" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="15" Height="15" Stretch="Uniform" Margin="12,0,4,0" ToolTip="받기"/></Grid></Button>
      <TextBlock Text="{Binding Expiry}" Foreground="{DynamicResource Faint}" FontSize="11" TextWrapping="Wrap" Margin="44,0,0,0"/>
     </StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="수신자 확인 현황" FontWeight="SemiBold" FontSize="12" Margin="0,18,0,7"/>
     <ItemsControl x:Name="ReceiptList"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Margin="0,4" Foreground="{DynamicResource Muted}" FontSize="11"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    </StackPanel></ScrollViewer>
    <Border Grid.Row="2" Padding="0,10,0,0" Margin="0,8,0,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Visibility="{Binding Visibility, ElementName=DetailPanel}">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="전달" Click="Forward" Margin="0,0,8,0" IsEnabled="{Binding IsVisible, ElementName=DetailPanel}"/><Button x:Name="ReplyButton" Content="답장" Click="Reply" Style="{StaticResource PrimaryButton}"  IsEnabled="{Binding IsVisible, ElementName=DetailPanel}"/></StackPanel>
    </Border>
   </Grid>
  </Grid>
 </DockPanel>
</Window>
